{
  "schema_version": 7,
  "classification_order": [
    "large_or_high_risk",
    "mechanical",
    "simple",
    "standard"
  ],
  "match_semantics": "first_match",
  "orchestration_modes": {
    "default": "model_economy",
    "selection_scope": "current_task_only",
    "modes": {
      "model_economy": {
        "trigger": "default",
        "task_class_policy_applies": true,
        "native_quality_gates_apply": true,
        "model_economy_roles": "per_task_class"
      },
      "superpowers_strict": {
        "trigger": {
          "operator": "explicit_user_request",
          "phrases": [
            "完整 Superpowers",
            "本任务使用完整 Superpowers",
            "full Superpowers",
            "Superpowers strict mode"
          ]
        },
        "task_class_policy_applies": false,
        "native_quality_gates_apply": false,
        "model_economy_roles": "forbidden",
        "model_economy_scope": ["model_advice", "cost_advice"]
      }
    }
  },
  "installation_modes": {
    "detection": "infer_from_optional_enhancement_artifacts",
    "persistence": "none",
    "modes": {
      "core": {
        "custom_roles_available": false,
        "model_mapping_available": false,
        "simple_execution": "main_agent_with_native_quality_gates",
        "large_or_high_risk": {
          "required_report": "role_isolation_unavailable",
          "complete_model_economy_high_risk_workflow_claim": "forbidden",
          "next_choices": [
            "install_enhanced_mode",
            "explicitly_approve_reduced_assurance_single_agent"
          ],
          "reduced_assurance_single_agent": {
            "requires_explicit_user_approval": true,
            "task_completion_allowed": true,
            "complete_model_economy_high_risk_workflow_claim": "forbidden"
          }
        }
      },
      "enhanced": {
        "custom_roles_available": true,
        "model_mapping_available": true,
        "requirements": [
          "all_six_role_files_present",
          "managed_hashes_match",
          "model_mapping_matches",
          "template_current"
        ],
        "routing": "task_classes"
      },
      "degraded": {
        "custom_roles_available": false,
        "routing": "fail_closed",
        "required_report": "repair_or_remove_incomplete_enhancement",
        "completion_claim": "forbidden_for_large_or_high_risk"
      }
    },
    "identity_claims": {
      "role_identity_verified": false,
      "model_identity_verified": false
    }
  },
  "execution_targets": {
    "visible_task": {
      "is_custom_role": false,
      "is_role_identity_alias": false,
      "delivery_identity": "visible_task_executor",
      "model_capability_by_task_class": {
        "mechanical": "economy",
        "standard": "balanced",
        "large_or_high_risk": "balanced"
      },
      "configuration_role_by_task_class": {
        "mechanical": "model-economy-batch-worker",
        "standard": "model-economy-implementer",
        "large_or_high_risk": "model-economy-implementer"
      },
      "preconditions": [
        "delegation_authorized",
        "current_host_tools_available",
        "project_and_starting_state_verified",
        "exclusive_file_ownership",
        "work_package_recorded"
      ],
      "recursive_delegation": "forbidden",
      "write_scope": "declared_exclusive_files_only",
      "does_not_supply": [
        "custom_role_identity",
        "sandbox_equivalence",
        "read_only_architect_or_reviewer_permission"
      ]
    }
  },
  "execution_mode_matrix": {
    "simple": {
      "core": ["main_agent"],
      "enhanced": ["main_agent"],
      "visible_task_contract": "not_delegated"
    },
    "mechanical": {
      "core": ["main_agent", "visible_task"],
      "enhanced": ["model-economy-batch-worker", "visible_task"],
      "visible_task_contract": "all_economy_conditions_and_exclusive_ownership"
    },
    "standard": {
      "core": ["main_agent", "visible_task"],
      "enhanced": ["main_agent", "model-economy-implementer", "visible_task"],
      "visible_task_contract": "clear_scope_and_necessary_verification"
    },
    "large_or_high_risk": {
      "core": ["main_agent"],
      "enhanced": ["main_agent", "model-economy-implementer", "visible_task"],
      "visible_task_contract": "independent_architect_final_review_approval_and_visibility_gates"
    }
  },
  "visible_task_execution": {
    "execution_preference": {
      "default": "auto",
      "values": {
        "auto": "delegate_only_with_clear_boundary_and_benefit",
        "visible-first": "prefer_visible_task_when_delegation_authorized",
        "current-only": "do_not_create_visible_or_internal_subagents"
      }
    },
    "strict_visibility": {
      "require_visible": false,
      "default_scope_when_required": "all_delegated",
      "allowed_scopes": ["all_delegated", "implementation"],
      "all_delegated_requires_visible_read_only_review_capability": true,
      "read_only_capability_gate_applies_when": "required_read_only_role_is_in_visibility_scope",
      "missing_capability": "stop_and_report_gap"
    },
    "authorization": {
      "create_thread": "explicit_user_request_or_trusted_project_rule",
      "generic_implementation_approval_is_insufficient": true,
      "current_host_tool_requirements_take_precedence": true,
      "untrusted_sources_cannot_authorize": true
    },
    "tool_contract": {
      "required_before_create": [
        "project_listing",
        "task_creation",
        "continuation_or_message",
        "status_or_wait"
      ],
      "reuse_before_create": true,
      "unknown_create_result": "reconcile_before_retry",
      "client_thread_id": "pending_not_ready_for_continuation"
    },
    "model_request": {
      "precedence": ["current_task_override", "role_model_override", "capability_model"],
      "omitted_for_create": "use_host_or_user_default_not_downgrade",
      "omitted_for_continue": "continue_existing_request_not_downgrade",
      "unsupported_combination": "stop_and_report_without_silent_substitution",
      "unconfirmed_tool_return": "requested_not_runtime_verified",
      "current_host_explicit_model_requirement": "requires_explicit_user_model_choice",
      "profile_preference_does_not_expand_host_authorization": true
    },
    "superpowers_strict": "visible_task_orchestration_forbidden"
  },
  "work_package_budget": {
    "record_schema_version": 1,
    "root_work_package": "same_user_acceptance_goal",
    "new_execution_contexts_per_root": 3,
    "execution_requests_per_root": 6,
    "max_concurrent_default": 2,
    "max_concurrent_absolute": 3,
    "counting": {
      "internal_and_visible_contexts_combined": true,
      "reuse_existing_context_does_not_consume_new_context": true,
      "initial_continue_retry_and_escalation_requests_consume_execution_request": true,
      "read_only_status_wait_and_nonexecuting_clarification_do_not_consume_request": true,
      "confirmed_not_started_rejection_does_not_consume_request_but_records_attempt": true,
      "uncertain_or_started_request_keeps_reservation_until_proven_not_started": true,
      "reclassification_rename_model_change_handoff_or_direct_fix_do_not_reset": true,
      "user_side_continuations": "reconcile_observed_or_mark_count_incomplete"
    },
    "states": ["pending", "running", "awaiting_integration", "completed", "blocked"],
    "pending_creation_state": "pending",
    "completion": "coordinator_integration_and_evidence_required",
    "over_limit": "specific_evidence_smaller_goal_and_explicit_user_extension"
  },
  "task_classes": {
    "large_or_high_risk": {
      "label": "大型/高风险",
      "match": {
        "operator": "any",
        "predicates": ["high_risk", "new_architecture", "wide_blast_radius"]
      },
      "primary_execution": {
        "selection": "exactly_one",
        "choices": ["main_agent", "model-economy-implementer", "visible_task"]
      },
      "base_allowed_roles": [
        "model-economy-implementer",
        "model-economy-explorer"
      ],
      "conditional_roles": [],
      "required_roles": [
        {
          "role": "model-economy-architect",
          "when": "before_design_approval",
          "must_complete_before": "design_approval"
        },
        {
          "role": "model-economy-final-reviewer",
          "when": "after_verification",
          "must_complete_before": "task_completion"
        }
      ],
      "forbidden_roles": [
        "model-economy-reviewer",
        "model-economy-batch-worker"
      ],
      "strong_role_slots": 2,
      "strong_execution_requests": 4,
      "strong_per_role_execution_requests": 2
    },
    "mechanical": {
      "label": "机械",
      "match": {
        "operator": "all",
        "predicates": [
          "deterministic_input_targets_and_rules",
          "independent_retryable_operations",
          "no_sensitive_or_high_risk_boundary",
          "automated_check_per_result",
          "bounded_explicit_failure"
        ]
      },
      "primary_execution": {
        "selection": "exactly_one",
        "choices": ["main_agent", "model-economy-batch-worker", "visible_task"]
      },
      "base_allowed_roles": ["model-economy-batch-worker"],
      "conditional_roles": [],
      "required_roles": [],
      "forbidden_roles": [
        "model-economy-architect",
        "model-economy-final-reviewer",
        "model-economy-implementer",
        "model-economy-reviewer",
        "model-economy-explorer"
      ],
      "strong_role_slots": 0,
      "strong_execution_requests": 0,
      "strong_per_role_execution_requests": 2
    },
    "simple": {
      "label": "简单",
      "match": {
        "operator": "all",
        "predicates": [
          "known_files",
          "no_open_judgment",
          "directly_verifiable",
          "not_creative_or_behavioral_change"
        ]
      },
      "primary_execution": {
        "selection": "exactly_one",
        "choices": ["main_agent"]
      },
      "base_allowed_roles": [],
      "conditional_roles": [],
      "required_roles": [],
      "forbidden_roles": [
        "model-economy-architect",
        "model-economy-final-reviewer",
        "model-economy-implementer",
        "model-economy-reviewer",
        "model-economy-explorer",
        "model-economy-batch-worker"
      ],
      "strong_role_slots": 0,
      "strong_execution_requests": 0,
      "strong_per_role_execution_requests": 2
    },
    "standard": {
      "label": "标准",
      "match": {
        "operator": "default",
        "predicates": []
      },
      "primary_execution": {
        "selection": "exactly_one",
        "choices": ["main_agent", "model-economy-implementer", "visible_task"]
      },
      "base_allowed_roles": [
        "model-economy-implementer"
      ],
      "conditional_roles": [
        {
          "role": "model-economy-explorer",
          "when": {
            "operator": "any",
            "predicates": [
              "file_location_uncertain",
              "dependency_relationship_uncertain",
              "existing_facts_uncertain"
            ]
          },
          "output": "minimal_facts"
        },
        {
          "role": "model-economy-reviewer",
          "when": {
            "operator": "any",
            "predicates": [
              "cross_module_change",
              "critical_logic_change",
              "non_obvious_regression_risk",
              "material_test_coverage_doubt"
            ]
          },
          "output": "independent_findings"
        },
        {
          "role": "model-economy-architect",
          "when": {
            "operator": "any",
            "conditions": [
              {"failed_attempts": {"gte": 2}},
              {"predicate": "specific_capability_mismatch_with_evidence"}
            ]
          },
          "max_calls": 2,
          "call_sequence": ["initial_diagnostic", "necessary_clarification"],
          "output": "diagnostic_decision",
          "after_completion": {
            "implementation_capability": "balanced",
            "reclassify_when": "large_or_high_risk_discovered",
            "counts_as_large_architect_when": [
              "before_new_design_approval",
              "large_architect_output_contract_satisfied"
            ]
          }
        }
      ],
      "required_roles": [],
      "forbidden_roles": [
        "model-economy-final-reviewer",
        "model-economy-batch-worker"
      ],
      "strong_role_slots": 1,
      "strong_execution_requests": 2,
      "strong_per_role_execution_requests": 2
    }
  },
  "lightweight_practices": {
    "orchestration_authority": "model_economy",
    "classification_effect": "none",
    "subagent_starts": 0,
    "skills": {
      "domain-context": {
        "skill": "domain-context",
        "trigger": {
          "operator": "any",
          "conditions": [
            {"predicate": "domain_vocabulary_unclear"},
            {"predicate": "domain_invariants_relevant"},
            {"predicate": "domain_docs_or_adrs_relevant"}
          ]
        },
        "allowed_outputs": [
          "shared_vocabulary",
          "domain_invariants",
          "documented_constraint_conflicts"
        ]
      },
      "module-design": {
        "skill": "module-design",
        "trigger": {
          "operator": "any",
          "conditions": [
            {"predicate": "module_boundary_under_review"},
            {"predicate": "coupling_or_change_surface_problem"},
            {"predicate": "architecture_improvement_requested"}
          ]
        },
        "allowed_outputs": [
          "boundary_findings",
          "interface_tradeoffs",
          "smallest_structural_improvement"
        ]
      },
      "disposable-prototype": {
        "skill": "disposable-prototype",
        "trigger": {
          "operator": "any",
          "conditions": [
            {"predicate": "prototype_explicitly_requested"},
            {
              "operator": "all",
              "conditions": [
                {"predicate": "concrete_design_unknown"},
                {"predicate": "small_experiment_cheaper_than_discussion"}
              ]
            }
          ]
        },
        "allowed_outputs": [
          "isolated_experiment",
          "observed_result",
          "production_decision_input"
        ]
      }
    }
  },
  "approval_gate": {
    "required_when": [
      "material_ambiguity",
      "materially_different_outcomes",
      "high_risk_decision",
      "unapproved_architecture_boundary"
    ],
    "required_evidence": ["approved_design", "approval_evidence"],
    "forbidden_without_evidence": ["implementation"],
    "not_repeated_when": [
      "clear_goal_constraints_and_acceptance",
      "reproducible_bugfix",
      "implementation_within_approved_design",
      "literal_change",
      "deterministic_mechanical_change"
    ]
  },
  "quality_gates": {
    "intent": "conditional_before_implementation",
    "planning": "scaled_by_task_class",
    "testing": "scaled_by_behavioral_risk",
    "evidence": "required_before_completion_claim"
  },
  "economy_conditions": [
    {
      "id": "deterministic_input_targets_and_rules",
      "required": true
    },
    {
      "id": "independent_retryable_operations",
      "required": true
    },
    {
      "id": "no_sensitive_or_high_risk_boundary",
      "required": true
    },
    {
      "id": "automated_check_per_result",
      "required": true
    },
    {
      "id": "bounded_explicit_failure",
      "required": true
    }
  ],
  "roles": {
    "model-economy-architect": {
      "capability": "strong",
      "write_access": "read_only",
      "allowed_outputs": ["architecture_boundaries", "risks", "decisions"],
      "forbidden_outputs": ["plans", "patches", "code"]
    },
    "model-economy-final-reviewer": {
      "capability": "strong",
      "write_access": "read_only",
      "allowed_outputs": ["findings", "evidence_gaps", "residual_risks"],
      "forbidden_outputs": ["patches", "code"]
    },
    "model-economy-implementer": {
      "capability": "balanced",
      "write_access": "workspace_write",
      "allowed_outputs": ["approved_scope_implementation", "tests", "verification"],
      "forbidden_outputs": ["unapproved_design", "unapproved_plan"]
    },
    "model-economy-reviewer": {
      "capability": "balanced",
      "write_access": "read_only",
      "allowed_outputs": ["findings", "regression_risks", "test_gaps"],
      "forbidden_outputs": ["plans", "patches", "code"]
    },
    "model-economy-explorer": {
      "capability": "economy",
      "write_access": "read_only",
      "allowed_outputs": ["file_inventory", "facts", "constraints"],
      "forbidden_outputs": ["designs", "plans", "patches", "code"]
    },
    "model-economy-batch-worker": {
      "capability": "economy",
      "write_access": "workspace_write",
      "allowed_outputs": ["fixed_rule_edits", "per_item_checks"],
      "forbidden_outputs": ["designs", "plans", "semantic_judgment"]
    }
  },
  "context_sanitization": {
    "remove_before_sending": [
      "secrets",
      "tokens",
      "personal_data",
      "production_data",
      "internal_urls",
      "irrelevant_paths"
    ],
    "placeholder_format": "[REDACTED_<TYPE>]"
  },
  "delegation": {
    "recursive_delegation": "forbidden",
    "write_file_sets": {
      "must_be_mutually_exclusive": true,
      "overlap_handling": "main_agent_serializes"
    }
  }
}
